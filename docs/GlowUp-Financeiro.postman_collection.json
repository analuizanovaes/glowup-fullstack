    {
      "name": "3 - Webhook",
      "item": [
        {
          "name": "Webhook payment (execute 2x: 2ª resposta é imediata)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/webhooks/mercadopago?data.id={{mpPaymentId}}&type=payment",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "webhooks",
                "mercadopago"
              ],
              "query": [
                {
                  "key": "data.id",
                  "value": "{{mpPaymentId}}"
                },
                {
                  "key": "type",
                  "value": "payment"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"payment.updated\",\n  \"api_version\": \"v1\",\n  \"data\": {\n    \"id\": \"{{mpPaymentId}}\"\n  },\n  \"id\": \"{{webhookEventoId}}\",\n  \"type\": \"payment\"\n}"
            },
            "auth": {
              "type": "noauth"
            },
            "description": "O status é sempre relido na API do Mercado Pago. Com webhookSecret preenchido, a assinatura x-signature é gerada automaticamente."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const segredo = pm.collectionVariables.get('webhookSecret');",
                  "if (segredo) {",
                  "  const dataId = pm.collectionVariables.get('mpPaymentId');",
                  "  const ts = Date.now().toString();",
                  "  const requestId = pm.variables.replaceIn('{{$guid}}');",
                  "  const manifesto = `id:${dataId.toLowerCase()};request-id:${requestId};ts:${ts};`;",
                  "  const v1 = CryptoJS.HmacSHA256(manifesto, segredo).toString(CryptoJS.enc.Hex);",
                  "  pm.request.headers.upsert({ key: 'x-signature', value: `ts=${ts},v1=${v1}` });",
                  "  pm.request.headers.upsert({ key: 'x-request-id', value: requestId });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
