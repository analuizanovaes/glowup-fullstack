# Template de variáveis de ambiente do GlowUp. Copie para ".env" e preencha. NUNCA commite o ".env".
# Em produção, defina os mesmos nomes como variáveis de ambiente.

# --- Banco PostgreSQL (local: banco "glowup" na sua máquina) ---
# Se a senha tiver caracteres especiais, deixe-a só em DB_PASS (não coloque na URL).
DB_URL=jdbc:postgresql://localhost:5432/glowup
DB_USER=postgres
DB_PASS=COLOQUE_A_SENHA_DO_SEU_POSTGRES

# --- Segurança (JWT) --- gere um valor aleatório por ambiente (veja docs/CONFIGURACAO_AMBIENTE.md)
JWT_SECRET=GERE_UM_SEGREDO_ALEATORIO_COM_64_CARACTERES

# --- E-mail (Resend, via HTTPS: não depende de SMTP) ---
RESEND_API_KEY=re_COLE_A_CHAVE_DE_ENVIO_DO_RESEND
RESEND_FROM=GlowUp <contato@SEU_DOMINIO_VERIFICADO>
# Produção: true. Local: defina false se quiser simular sem enviar mensagens.
EMAIL_ENVIO_HABILITADO=true
ADMIN_NOTIFICACAO_EMAIL=

# --- Mercado Pago (credenciais de TESTE) ---
MP_TEST_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_NOTIFICATION_URL=
MP_EMAIL_PAGADOR_TESTE=

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Conta administradora (criada na 1ª subida se não existir; use senha forte) ---
ADMIN_EMAIL=
ADMIN_SENHA_INICIAL=
ADMIN_NOME=Domingas
# true (padrão) exige trocar a senha no 1º acesso. Local: pode usar false.
ADMIN_SENHA_PROVISORIA=true

# --- CORS e Swagger ---
# Local pode usar *. Em produção informe a URL do front, ex.: https://seu-front.exemplo.com
CORS_ALLOWED_ORIGINS=*
# Deixe true só no ambiente local; em produção não defina (o padrão é desligado)
SWAGGER_ENABLED=true

# --- Execução ---
# OBRIGATÓRIO definir o perfil. Local: "local". Em produção: "prod" (sem ele a API recusa subir com segredo padrão).
# JPA_SHOW_SQL vem desligado por padrão; ligue só no .env local.
SPRING_PROFILES_ACTIVE=local
JPA_SHOW_SQL=true

# --- Termos de uso (RD04) e limite de requisições ---
TERMOS_VERSAO_ATUAL=1.0
RATELIMIT_AUTH_MAX=20
RATELIMIT_AUTH_JANELA_MIN=15

# --- Bloqueio de login por conta (além do limite por IP): N erros na janela bloqueiam o e-mail ---
LOGIN_MAX_FALHAS=10
LOGIN_JANELA_MIN=15
LOGIN_BLOQUEIO_MIN=15

# --- WhatsApp da revendedora (link de retirada, RN09): só dígitos com DDI, ex.: 5561999999999 ---
WHATSAPP_NUMERO=

# --- Sessão: access token curto + refresh token (renovação sem pedir a senha) ---
# Até o front implementar POST /api/auth/refresh, use JWT_EXPIRACAO_MINUTOS=120 para não deslogar a cada 30 min.
JWT_EXPIRACAO_MINUTOS=30
REFRESH_TOKEN_DIAS=7

# --- Limites extras (por IP e janela): checkout/pagamento e consulta de CEP ---
RATELIMIT_PEDIDO_MAX=30
RATELIMIT_CEP_MAX=100
# Sincronização de pagamento: chamadas por minuto e por IP
RATELIMIT_SINCRONIZAR_MAX_MIN=12

# --- IP real atrás de um proxy reverso ---
# Ligue RATELIMIT_LOGAR_IP=true no 1º deploy, confira o IP no log e desligue.
RATELIMIT_LOGAR_IP=false
# RATELIMIT_IP_ULTIMO_XFF=false
# SERVER_TOMCAT_REMOTEIP_INTERNAL_PROXIES=

# --- Banco e encerramento ---
DB_POOL_MAX=10
DB_POOL_MIN_IDLE=2
SHUTDOWN_TIMEOUT=25s

# --- Webhook do Mercado Pago: tolerância (segundos) do timestamp assinado ---
MP_WEBHOOK_TOLERANCIA_SEGUNDOS=900
