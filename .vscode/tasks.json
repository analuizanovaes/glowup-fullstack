        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Rodar tudo (API + Frontend)",
      "dependsOn": [
        "API: rodar (Spring Boot)",
        "Frontend: servir (porta 5500)"
